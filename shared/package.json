{
  "name": "@project-exodus/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tipos, constantes e dados compartilhados cliente↔servidor (zero dependências de runtime)",
  "exports": {
    ".": {

      "import": "./dist/protocol.js"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "import": "./dist/units.js"
    },
    "./economy": {
      "types": "./dist/economy.d.ts",
      "import": "./dist/economy.js"
    },
    "./world": {
      "types": "./dist/world.d.ts",
      "import": "./dist/world.js"
    },
    "./collision": {
      "types": "./dist/collision.d.ts",
      "import": "./dist/collision.js"
    }

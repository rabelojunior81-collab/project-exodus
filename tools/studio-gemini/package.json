{
  "name": "@project-exodus/studio-gemini",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asset Generation & Build Studio utilizing Gemini API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsx tests/gemini_connectivity.test.ts",
